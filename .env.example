# Local development — copy to .env.local and fill in values
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_CHAIN=8453

# Public site URL — must match an allowed domain in WalletConnect Cloud
NEXT_PUBLIC_SITE_URL=https://orbit-os-rho.vercel.app

# Optional: enable aomi-transact CLI staging on the server
# AOMI_ENABLED=1

# Optional: force mocked Zora tools instead of aomi-transact CLI
# AOMI_USE_MOCK=1

# Sentry monitoring (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
